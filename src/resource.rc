IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 275, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ユーザー設定"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "表示言語:",IDC_OPT_LBL_LANG,14,14,75,10
    COMBOBOX        IDC_OPT_COMBO_LANG,95,12,110,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "リスト表示フォント:",IDC_OPT_LBL_LIST_FONT,14,34,75,10
    LTEXT           "",IDC_OPT_LBL_LIST_FONT_VAL,95,34,105,10,SS_LEFTNOWORDWRAP
    PUSHBUTTON      "変更...",IDC_OPT_BTN_LIST_FONT,208,32,52,14
    LTEXT           "UI / メニューフォント:",IDC_OPT_LBL_UI_FONT,14,54,75,10
    LTEXT           "",IDC_OPT_LBL_UI_FONT_VAL,95,54,105,10,SS_LEFTNOWORDWRAP
    PUSHBUTTON      "変更...",IDC_OPT_BTN_UI_FONT,208,52,52,14
    LTEXT           "更新頻度:",IDC_OPT_LBL_INTERVAL,14,74,75,10
    CONTROL         "",IDC_OPT_SLIDER_INTERVAL,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,95,70,110,18
    LTEXT           "",IDC_OPT_LBL_INTERVAL_VAL,210,74,52,10
    CONTROL         "常に手前に表示",IDC_OPT_CHK_ALWAYS_TOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,96,245,10
    CONTROL         "最小化時にタスクトレイに格納",IDC_OPT_CHK_TRAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,112,245,10
    LTEXT           "除外対象プロセス:",IDC_OPT_LBL_EXCLUDED,14,136,186,10
    CONTROL         "",IDC_OPT_LIST_EXCLUDED,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,14,148,186,56
    PUSHBUTTON      "追加(&A)...",IDC_OPT_BTN_ADD_EXCLUDED,208,148,52,14
    PUSHBUTTON      "削除(&D)",IDC_OPT_BTN_DEL_EXCLUDED,208,166,52,14
    DEFPUSHBUTTON   "OK",IDOK,155,224,52,16
    PUSHBUTTON      "キャンセル",IDCANCEL,212,224,52,16
END

IDD_ADD_EXCLUDED_DIALOG DIALOGEX 0, 0, 210, 75
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "除外プロセスの追加"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "除外するプロセス名:",IDC_ADD_EXCL_PROMPT,12,12,186,10
    EDITTEXT        IDC_ADD_EXCL_EDIT,12,24,186,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,96,48,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,148,48,50,14
END

IDD_COLUMN_SELECTOR_DIALOG DIALOGEX 0, 0, 310, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "列の選択"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "プロセス一覧に表示する列を選択してください:",IDC_COL_INSTRUCTION,12,10,285,10
    CONTROL         "",IDC_COL_LIST,"SysListView32",LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,12,24,210,185
    PUSHBUTTON      "上へ移動(&U)",IDC_COL_BTN_MOVE_UP,230,24,68,16
    PUSHBUTTON      "下へ移動(&D)",IDC_COL_BTN_MOVE_DOWN,230,46,68,16
    PUSHBUTTON      "すべて選択(&A)",IDC_COL_BTN_SELECT_ALL,230,74,68,16
    PUSHBUTTON      "既定値に戻す(&R)",IDC_COL_BTN_DEFAULT,230,96,68,16
    DEFPUSHBUTTON   "OK",IDOK,190,222,52,16
    PUSHBUTTON      "キャンセル",IDCANCEL,246,222,52,16
END

IDD_MONITOR_DIALOG DIALOGEX 0, 0, 380, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "プロセス監視ルール"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_MONITOR_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,10,12,290,165
    PUSHBUTTON      "新規追加(&N)...",IDC_MONITOR_BTN_ADD,308,12,62,16
    PUSHBUTTON      "編集(&E)...",IDC_MONITOR_BTN_EDIT,308,32,62,16
    PUSHBUTTON      "削除(&D)",IDC_MONITOR_BTN_DELETE,308,52,62,16
    PUSHBUTTON      "有効/無効(&T)",IDC_MONITOR_BTN_TOGGLE,308,77,62,16
    PUSHBUTTON      "テスト(警告)",IDC_MONITOR_BTN_TEST_WARN,308,102,62,16
    PUSHBUTTON      "テスト(重大)",IDC_MONITOR_BTN_TEST_ERR,308,122,62,16
    DEFPUSHBUTTON   "閉じる",IDOK,308,192,62,16
END

IDD_RULE_EDIT_DIALOG DIALOGEX 0, 0, 280, 184
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ルール編集"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "ルール名:",IDC_RULE_LBL_NAME,12,14,55,10
    EDITTEXT        IDC_RULE_EDIT_NAME,72,12,192,14,ES_AUTOHSCROLL
    LTEXT           "監視対象:",IDC_RULE_LBL_TARGET,12,34,55,10
    COMBOBOX        IDC_RULE_COMBO_TARGET,72,32,88,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_RULE_COMBO_MATCH,165,32,99,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "パターン:",IDC_RULE_LBL_PATTERN,12,54,55,10
    EDITTEXT        IDC_RULE_EDIT_PATTERN,72,52,192,14,ES_AUTOHSCROLL
    CONTROL         "対象プロセスが存在しない場合に通知",IDC_RULE_CHK_NOT_FOUND,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,72,70,192,12
    LTEXT           "重要度:",IDC_RULE_LBL_LEVEL,12,88,55,10
    COMBOBOX        IDC_RULE_COMBO_LEVEL,72,86,88,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "発火条件:",IDC_RULE_LBL_CONDITION,12,108,55,10
    COMBOBOX        IDC_RULE_COMBO_COL,72,106,100,140,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_RULE_COMBO_OP,176,106,34,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_RULE_EDIT_VALUE,214,106,50,14,ES_AUTOHSCROLL
    LTEXT           "通知間隔:",IDC_RULE_LBL_COOLDOWN,12,130,55,10
    CONTROL         "",IDC_RULE_SLIDER_COOLDOWN,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,72,126,135,18
    LTEXT           "",IDC_RULE_LBL_COOLDOWN_VAL,212,130,52,10
    DEFPUSHBUTTON   "保存",IDOK,160,158,50,16
    PUSHBUTTON      "キャンセル",IDCANCEL,215,158,50,16
END

